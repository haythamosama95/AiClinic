{
  "name": "ai-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --env development",
    "bootstrap:routing-policy": "bash scripts/bootstrap-routing-policy.sh",
    "deploy": "wrangler deploy",
    "check": "wrangler check",
    "verify-manifests": "vitest run test/manifest-registry-gate.test.ts test/prompt-registry-gate.test.ts",
    "test": "npm run verify-manifests && vitest run && vitest run --config vitest.workers.config.ts",
    "test:unit": "vitest run",
    "test:load": "vitest run --config vitest.workers.config.ts test/load/load-and-cost.test.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@cloudflare/workers-types": "^4.20250730.0",
    "@msw/cloudflare": "^0.2.0",
    "miniflare": "5.20261012.0-beta",
    "msw": "^3.0.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12",
    "wrangler": "~4.86.0"
  },
  "dependencies": {
    "vendor-contracts": "file:../packages/vendor-contracts"
  }
}
