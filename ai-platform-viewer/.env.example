# Optional overrides. When VITE_SUPABASE_ANON_KEY is empty, dev server reads
# SUPABASE_PUBLIC_URL and SUPABASE_ANON_KEY from backend/local/.env instead.
# Admin credentials load from VITE_BOOTSTRAP_* here, or bootstrap defaults via /api/dev/config.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_BOOTSTRAP_ADMIN_USERNAME=admin
VITE_BOOTSTRAP_ADMIN_PASSWORD=admin
